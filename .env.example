# Skopíruj na .env a uprav podľa potreby
ROS_DOMAIN_ID=0

# Ak chceš images taggovať pre registry (napr. ghcr.io/tvojucet/), inak nechaj prázdne
REGISTRY=

# Statický TF base_link -> velodyne z lidar_localization kontajnera.
# Nechaj false, ak MowgliNext URDF (robot_state_publisher) už frame "velodyne" má -
# dva publisheri tej istej hrany = konflikt v TF strome.
# Bez tejto hrany lokalizácia nefunguje (cloud sa transformuje do base_link).
LIDAR_TF_PUBLISH=false
LIDAR_TF_X=0.0
LIDAR_TF_Y=0.0
LIDAR_TF_Z=0.40
