# Skopíruj na .env a uprav podľa potreby
ROS_DOMAIN_ID=0

# Montáž VLP16 voči base_link (m, rad) -> statický TF base_link -> velodyne.
# base_link v MowgliNext = stred kolesovej osi. Z = výška lidaru nad base_link,
# nie nad zemou (odpočítaj výšku osi). Ak je lidar otočený o 180°, YAW=3.14159.
# Nuly = lokalizácia vracia polohu lidaru, nie robota.
LIDAR_TF_X=0.0
LIDAR_TF_Y=0.0
LIDAR_TF_Z=0.0
LIDAR_TF_ROLL=0.0
LIDAR_TF_PITCH=0.0
LIDAR_TF_YAW=0.0

# Ak chceš images taggovať pre registry (napr. ghcr.io/tvojucet/), inak nechaj prázdne
REGISTRY=
